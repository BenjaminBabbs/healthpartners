# Copy this file, name it whatever you like (e.g. .env), fill in the values, then export before running:
#   export $(cat your-env-file | grep -v '^#' | xargs)

METASTORE_URL=https://data.cms.gov/provider-data/api/1/metastore/schemas/dataset/items
OUTPUT_DIR=hospital_data
METADATA_FILE=run_metadata.json
WORKERS=8
MAX_RETRIES=3
RETRY_BACKOFF=1.0
LOG_LEVEL=INFO
LOG_FILE=cms_pipeline.log
